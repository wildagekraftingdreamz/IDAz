{
  "name": "idaz",
  "productName": "IDAz",
  "version": "1.0.0",
  "description": "IDAz - a nostalgic ICQ 5 style desktop messenger for WhatsApp and Telegram",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "author": "wildagekraftingdreamz",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "preview": "vite",
    "build": "node scripts/gen-assets.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/gen-assets.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "qrcode": "^1.5.4",
    "telegram": "^2.26.22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
